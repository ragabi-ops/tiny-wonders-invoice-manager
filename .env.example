# ---- API ----
APP_ENV=development
HTTP_ADDR=:8080
# Comma separated. Web dev server origin.
CORS_ORIGINS=http://localhost:5173
# Must match the port in HTTP_ADDR; the Vite dev server proxies to it.
VITE_API_PORT=8080
# "true" only behind HTTPS (production)
SECURE_COOKIES=false
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# ---- Database ----
# Host port for the development container. 5433 by default, so a PostgreSQL
# already running on the host keeps 5432.
DEV_DB_PORT=5433
# Host port for the development PDF renderer.
DEV_PDF_PORT=3000
DATABASE_URL=postgres://invoice:invoice@localhost:5433/invoice?sslmode=disable

# ---- Business ----
BUSINESS_MODE=EXEMPT_DEALER
TIMEZONE=Asia/Jerusalem

# ---- Bootstrap owner (first run only; remove afterwards) ----
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=

# ---- Backups ----
# Where the daily archive is written. Leave empty to disable backups entirely —
# the system will say so rather than pretend. Point this at a folder your own
# sync tool uploads; the archive is NOT encrypted, so protect that folder.
BACKUP_DIR=./backups
# Time of day, in the business timezone.
BACKUP_AT=02:00
# How many archives to keep in the folder. This is disk hygiene, not records
# retention: financial records themselves are never pruned.
BACKUP_RETENTION_DAYS=30
# Only needed when several PostgreSQL client versions are installed.
PG_DUMP_PATH=

# ---- Storage: issued PDFs and attachments ----
STORAGE_DIR=./storage

# How often the background worker polls for queued work (email, exports).
JOB_POLL_INTERVAL_MS=5000

# ---- Email (optional) ----
# Leave SMTP_HOST empty to run without email: the UI then offers WhatsApp share
# and PDF download only, instead of a send that cannot work.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ---- PDF renderer ----
# Required to issue documents. Without it, issuance is refused rather than
# producing a document with no PDF.
GOTENBERG_URL=http://localhost:3000

# ---- Full stack (deployments/docker-compose.yml) ----
# Host port for the Caddy proxy, published on 127.0.0.1 only, so the app is
# reachable from this machine and nowhere else. Pick something non-standard if
# you develop other projects on the same machine. HTTPS only: port 80 is not
# published, so there is no plain-HTTP listener to downgrade onto.
HTTPS_PORT=9843
# Scheme and hostname for the stack. Behind a hosts-file entry no public CA can
# issue for the name, so the Caddyfile uses `tls internal` and signs with its
# own CA — trust that CA once (docs/RUNBOOK.md). For a genuinely public site,
# drop `tls internal` from the Caddyfile and Caddy provisions a real
# certificate for this address automatically.
SITE_ADDRESS=https://invoices.example.com
# Required by the stack. Generate one and keep it out of version control:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40
POSTGRES_PASSWORD=
# Host folder the stack writes its daily archive into, bind-mounted into the API
# container. Keep it separate from BACKUP_DIR above: that one belongs to a local
# `go run` against the development database, and two databases writing archives
# into one folder under identical names is how a restore applies the wrong dump.
STACK_BACKUP_DIR=
